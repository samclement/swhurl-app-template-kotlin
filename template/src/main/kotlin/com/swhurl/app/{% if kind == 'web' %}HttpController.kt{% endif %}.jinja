import io.opentelemetry.api.trace.Span
import org.slf4j.LoggerFactory
import org.slf4j.MDC

@Serdeable
data class Health(val ok: Boolean)

@Serdeable
data class Hello(
    val message: String,
    val service: String,
    val caller: Caller,
    // How many times it was asked, when the app keeps a database.
    val visits: Long?,
)

@Serdeable
data class Refusal(val error: String)

@Serdeable
data class Called(val called: String, val status: Int, val reply: String)

@Serdeable
data class Notified(val sent: Boolean)

private const val CALLER = "swhurl.caller"

// Who is calling, before any route runs: another app (it sent a token the platform issued for this
// app alone), a signed-in person, or anonymous. A bad token is answered 401 here; see Platform.kt.
@ServerFilter("/**")
class CallerFilter(private val platform: Platform) {
    private val log = LoggerFactory.getLogger(CallerFilter::class.java)

    @RequestFilter
    fun identify(request: HttpRequest<*>): HttpResponse<*>? {
        if (request.path == "/healthz") return null
        return try {
            val caller = platform.identify(
                request.headers.get("Authorization"),
                request.headers.get("X-Auth-Request-Email"),
                request.headers.get(USER_HEADER),
            )
            request.setAttribute(CALLER, caller)
            Span.current().setAttribute("caller.type", caller.type)
            if (caller.id != null) Span.current().setAttribute("caller.id", caller.id)
            if (caller.user != null) Span.current().setAttribute("user.email", caller.user)
            null
        } catch (refused: Unauthorized) {
            log.warn("request refused: ${refused.message}")
            HttpResponse.status<Refusal>(HttpStatus.UNAUTHORIZED).body(Refusal(refused.message ?: "unauthorized"))
        }
    }
}

{%- if api == 'openapi' %}
// What this app offers other apps: src/main/resources/openapi.yaml is generated from the routes
// below (./gradlew openapi), committed, and served at /openapi.yaml. The platform reads the file.
@OpenAPIDefinition(info = Info(title = {{ app_name | tojson }}, version = "0.1.0", description = {{ description | tojson | replace('$', '\\$') }}))
{%- endif %}
@Controller
class HttpController(
    @Value("\${otel.service.name:swhurl-app}") private val serviceName: String,
    private val platform: Platform,
    private val events: Events,
{%- if database == 'sqlite' %}
    private val database: Database,
{%- endif %}
) {
    private val log = LoggerFactory.getLogger(HttpController::class.java)
{%- if api == 'openapi' %}
    private val yaml = YAMLMapper.builder()
        .disable(YAMLWriteFeature.WRITE_DOC_START_MARKER)
        .enable(YAMLWriteFeature.MINIMIZE_QUOTES)
        .build()
{%- endif %}

    // The platform's readiness and liveness probe: the app answers only once started{% if database == 'sqlite' %} (the database
    // opens and migrates at startup){% endif %}, and reports not ready until its feature flag overrides have arrived
    // (at most 5 s; FlagWatcher). Probe requests are not traced.
{%- if api == 'openapi' %}
    @Hidden
{%- endif %}
    @Get("/healthz")
    fun health(): HttpResponse<Health> =
        if (Flags.store.loaded) HttpResponse.ok(Health(true)) else HttpResponse.status<Health>(HttpStatus.SERVICE_UNAVAILABLE).body(Health(false))
{%- if api == 'openapi' %}

    // The description itself, as other apps and people fetch it: named and described as the platform runs
    // this app (SWHURL_APP; SWHURL_DESCRIPTION, from swhurl.yaml), so an image built for another app says the
    // right thing. Off the platform it is the file as committed.
    @Hidden
    @Get("/openapi.yaml", produces = ["application/yaml"])
    fun openapi(): String {
        val text = HttpController::class.java.getResource("/openapi.yaml")!!.readText()
        val name = platform.setting("SWHURL_APP")
        val description = platform.setting("SWHURL_DESCRIPTION")
        if (name == null && description == null) return text
        val document = yaml.readTree(text) as ObjectNode
        val info = document.get("info") as ObjectNode
        name?.let { info.put("title", it) }
        description?.let { info.put("description", it) }
        return yaml.writeValueAsString(document)
    }
{%- endif %}

    private fun caller(request: HttpRequest<*>): Caller =
        request.getAttribute(CALLER, Caller::class.java).orElse(Caller("anonymous", null))

    // Every log line of a request names its caller (and, with the agent, its trace).
    private fun logged(request: HttpRequest<*>, status: Int) {
        val caller = caller(request)
        MDC.putCloseable("caller.type", caller.type).use {
            MDC.putCloseable("caller.id", caller.id ?: "").use {
                MDC.putCloseable("user.email", caller.user ?: "").use {
                    log.info("request handled: ${request.methodName} ${request.path} $status")
                }
            }
        }
    }

    // An example of calling another app: GET /call/orders asks the app "orders" for its "/" and returns
    // what it said. It works once the platform grants this app the call (make app-calls).
    // onBehalfOf tells orders who is signed in here, so its "/" names this app and that person.
{%- if api == 'openapi' %}
    @Operation(summary = "Ask another app for its greeting (an example of calling)")
{%- endif %}
    @Get("/call/{name}")
    fun call(@PathVariable name: String, request: HttpRequest<*>): HttpResponse<Called> {
        val result = try {
            val reply = platform.call(name, "/", onBehalfOf = caller(request))
            Called(name, reply.statusCode(), reply.body())
        } catch (problem: Exception) {
            Called(name, 0, problem.message ?: problem.javaClass.simpleName)
        }
        val status = if (result.status in 200..299) HttpStatus.OK else HttpStatus.BAD_GATEWAY
        logged(request, status.code)
        return HttpResponse.status<Called>(status).body(result)
    }

    // An example of notifying the team: POST /notify sends a message to the notification channel of
    // the team that owns this app, and says whether the platform accepted it.
{%- if api == 'openapi' %}
    @Operation(summary = "Send a message to the team's notification channel (an example)")
{%- endif %}
    @Post("/notify")
    fun notifyTeam(request: HttpRequest<*>): Notified {
        val sent = platform.notify(
            "Hello from the example route",
            message = "Asked for by ${caller(request).id ?: "an anonymous caller"}.",
        )
        logged(request, HttpStatus.OK.code)
        return Notified(sent)
    }

    // The caller is a signed-in person (sign-in happens before requests reach the app), another app, or anonymous.
{%- if api == 'openapi' %}
    @Operation(summary = "Say hello and name the caller")
{%- endif %}
    @Get("/")
    fun hello(request: HttpRequest<*>): Hello {
{%- if database == 'sqlite' %}
        val visits = database.recordVisit("/")
{%- endif %}
        // An example of publishing: "visited" is described in asyncapi.yaml, which is what lets other
        // apps find it and subscribe. Off the platform the payload is still checked, and nothing is sent.
        listOf("visited").forEach { declared ->
            try {
                val caller = caller(request)
                val named = mapOf("type" to caller.type, "id" to caller.id) + (caller.user?.let { mapOf("user" to it) } ?: emptyMap())
                events.publish(declared, mapOf("path" to "/", "caller" to named))
            } catch (problem: Exception) {
                log.error("event not published: $declared: ${problem.message}")
            }
        }
        logged(request, 200)
        // An example of a feature flag: shout is declared in swhurl.yaml, on in staging only.
        val greeting = "hello from $serviceName"
        return Hello(if (Flags.shout) greeting.uppercase() else greeting, serviceName, caller(request), {% if database == 'sqlite' %}visits{% else %}null{% endif %})
    }
}
