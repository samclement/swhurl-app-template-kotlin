# What this app needs from the swhurl platform. Read by the platform's `make app-new --from-repo`;
# fields: https://github.com/samclement/swhurl-platform/blob/main/docs/apps.md#swhurlyaml
version: 1
stack: kotlin
kind: {{ kind }}
{%- if kind == 'web' %}
port: 8080
healthPath: /healthz
{%- endif %}
uid: 65532
telemetry: otlp
autoDeploy: true
{%- if database == 'sqlite' %}
database: sqlite
{%- endif %}
# The JVM needs more than the platform's defaults (10m, 32Mi, limit 128Mi).
resources:
  cpu: 100m
  memory: 192Mi
  memoryLimit: 384Mi
{%- if kind == 'web' and api == 'openapi' or events == 'asyncapi' %}
# What this app offers other apps: its API description (served, and kept in the repository) and its events.
# The platform reads both files for every image; the events file says what the app publishes.
provides:
{%- if kind == 'web' and api == 'openapi' %}
  api: /openapi.yaml
  apiFile: src/main/resources/openapi.yaml
{%- endif %}
{%- if events == 'asyncapi' %}
  eventsFile: src/main/resources/asyncapi.yaml
{%- endif %}
{%- endif %}
{%- if flags == 'example' %}
# Feature flags: typed, with a value per environment; the build generates the Flags object from them.
# https://github.com/samclement/swhurl-platform/blob/main/docs/apps.md#feature-flags
flags:
  shout:
    type: boolean
    description: Say hello in capitals
    default: false
    staging: true
{%- endif %}
